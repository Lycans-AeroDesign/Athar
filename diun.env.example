# Email settings for the `diun` service in docker-compose.prod.yml, which
# tells you when a running image tag has a newer build to pull (opt-in:
# start it with `--profile updates`, see DEPLOYMENT.md).
# Copy to diun.env (gitignored) and fill in; without diun.env Diun only logs.
# Usually the same SMTP account as EMAIL_* in .env. See DEPLOYMENT.md.
#
# Port 587 = STARTTLS (DIUN_NOTIF_MAIL_SSL=false); 465 = SSL (true).
DIUN_NOTIF_MAIL_HOST=smtp.example.com
DIUN_NOTIF_MAIL_PORT=587
DIUN_NOTIF_MAIL_SSL=false
DIUN_NOTIF_MAIL_USERNAME=
DIUN_NOTIF_MAIL_PASSWORD=
DIUN_NOTIF_MAIL_FROM=diun@mail.example.com
# Comma-separated list of recipients.
DIUN_NOTIF_MAIL_TO=you@example.com
