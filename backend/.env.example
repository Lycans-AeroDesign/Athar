# Copy this file to backend/.env for local (non-docker) development.
# When running via docker-compose, most of these are supplied by the root
# .env / docker-compose.yml instead — see the root .env.example.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - required, no SQLite fallback.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://lycans:lycans@localhost:5432/lycans_kms

# CORS - comma-separated list of origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT auth
# Uncomment to sign tokens with a key other than SECRET_KEY.
# JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Refresh token cookie (httpOnly, never readable by frontend JS)
JWT_REFRESH_COOKIE_NAME=refresh_token
# Defaults to `not DEBUG` if unset - only set explicitly to override.
# JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
# Uncomment for a cookie shared across subdomains (e.g. ".example.com").
# JWT_REFRESH_COOKIE_DOMAIN=

# Public self-registration endpoint
ENABLE_REGISTRATION=True

# Max upload size for the generic file endpoint (branding logo/favicon today)
MAX_UPLOAD_SIZE_MB=2

# File storage - local disk by default (nothing to set). Set
# AWS_STORAGE_BUCKET_NAME to switch to any S3-compatible object storage
# instead (AWS S3, Cloudflare R2, Backblaze B2, self-hosted MinIO, ...).
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# Only needed for non-AWS S3-compatible providers (R2/MinIO/B2) - leave
# unset for real AWS S3.
# AWS_S3_ENDPOINT_URL=
# "virtual" (default) works for AWS S3 and most managed providers; MinIO
# and some self-hosted S3-compatible servers need "path" instead.
# AWS_S3_ADDRESSING_STYLE=virtual

# Celery broker (org backup export jobs - see Settings > Backups). Only
# needed if running the celery-worker service/process yourself outside
# docker-compose, which already sets this.
CELERY_BROKER_URL=redis://localhost:6379/0
