# Copy this file to backend/.env for local (non-docker) development.
# When running via docker-compose, most of these are supplied by the root
# .env / docker-compose.yml instead — see the root .env.example.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave unset to fall back to SQLite (backend/db.sqlite3).
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://lycans:lycans@localhost:5432/lycans_kms

# CORS - comma-separated list of origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000
