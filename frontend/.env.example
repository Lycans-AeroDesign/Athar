# Copy this file to frontend/.env for local (non-docker) development.

# Base URL the frontend uses to reach the Django API. Leave unset/empty for a
# same-origin deployment behind the bundled nginx (see docker-compose.prod.yml)
# - only set this to an absolute origin (scheme+host, no /api suffix - the
# frontend's own request paths already include it) when reaching the backend
# at a different origin than whatever serves the frontend, as here for bare
# `npm run dev` against the docker-compose.yml backend's exposed port.
NEXT_PUBLIC_API_URL=http://localhost:8000
