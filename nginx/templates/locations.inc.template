# ====================================================
# SHARED LOCATION BLOCKS - included inside the server{} block of both
# dev.conf.template (plain HTTP) and prod.conf.template (HTTPS, behind
# Let's Encrypt) via `include /etc/nginx/conf.d/locations.inc;` - kept in
# one file so the two environments' proxy/security behavior can't drift
# apart from each other. This file's own .template suffix still gets
# stripped by envsubst like any other template, but note it renders to
# "locations.inc" (not "locations.conf") specifically so nginx's own
# `include conf.d/*.conf` wildcard (in its base image config) never loads
# it directly at the top level, where bare `location` blocks outside a
# server{} would be a syntax error - it's only ever reachable via the
# explicit `include` line in dev.conf.template/prod.conf.template.
#
# $scheme is trustworthy here in both environments: dev's server only ever
# listens on plain HTTP, and prod's HTTPS server (where this is actually
# included) is the TLS termination point itself, not a hop behind some
# other proxy - no X-Forwarded-Proto trust/spoofing question to worry about.
#
# The same goes for X-Forwarded-For: every location below sets it to
# $remote_addr (overwrite), never $proxy_add_x_forwarded_for (append).
# nginx is the edge, so any X-Forwarded-For arriving from the client is
# attacker-controlled - appending would pass it through to Django, where
# DRF's throttles and the audit log's client IP (NUM_PROXIES=1, see
# backend/config/settings.py) would trust it. If this ever moves behind a
# CDN/load balancer, switch to ngx_http_realip_module with that proxy's
# address range in set_real_ip_from rather than reverting to append.
# ====================================================

# ------------------------------------------------
# SECURITY HEADERS
# Django's own SecurityMiddleware/XFrameOptionsMiddleware already send
# X-Content-Type-Options/X-Frame-Options/Referrer-Policy by default (see
# backend/config/settings.py) - add_header alone would APPEND to those,
# not replace them, leaving two (for Referrer-Policy, conflicting) values
# on the same response. proxy_hide_header strips the upstream's copy
# first so nginx's values below are the only ones that reach the client.
# ------------------------------------------------
proxy_hide_header X-Content-Type-Options;
proxy_hide_header X-Frame-Options;
proxy_hide_header Referrer-Policy;
add_header X-Content-Type-Options nosniff always;
add_header X-Frame-Options DENY always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# ------------------------------------------------
# CSP (Content Security Policy) - REPORT-ONLY
# Browsers never block anything under Report-Only; they only log each
# violation to the devtools console ("[Report Only] Refused to ..."). This
# is the observation phase: browse the production site with devtools open,
# fix or allow whatever shows up, then rename the header to
# Content-Security-Policy to enforce it.
#
# What each source is for:
# - script/style 'unsafe-inline': Next.js App Router emits inline bootstrap
#   scripts and styles without nonces.
# - img https:: Markdown content may embed external images.
# - blob: (img/frame/media/worker): AuthenticatedImage/PdfViewer load
#   protected files as blob: object URLs (see CLAUDE.md).
# - frame-src hosts: the lesson video/document embeds allowed in
#   frontend/lib/training/video.ts (YouTube, Google Drive, SharePoint/OneDrive).
# Expect noise in dev (Turbopack HMR uses eval and websockets); judge the
# policy against a production build only.
# ------------------------------------------------
add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self' blob: https://www.youtube.com https://www.youtube-nocookie.com https://drive.google.com https://*.sharepoint.com https://onedrive.live.com https://*.officeapps.live.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

# ------------------------------------------------
# STATIC FILES (DJANGO)
# Proxied to the backend rather than served directly from a shared
# filesystem alias - WhiteNoise already serves /static/ as part of the
# normal Django request/response cycle in both DEBUG (via
# WHITENOISE_USE_FINDERS, straight from each app's static/ dir - see
# backend/config/settings.py) and non-DEBUG (from the collected
# STATIC_ROOT), so there is nothing extra nginx needs mounted to make
# this work correctly in either environment.
# ------------------------------------------------
location /static/ {
    limit_req zone=api_limit burst=50 nodelay;
    proxy_pass http://backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "public, max-age=86400";
    access_log off;
}

# ------------------------------------------------
# MEDIA - no direct serving
# Every uploaded file in this app requires an authenticated, permission-
# checked Django request to download (see backend/files/views.py) - there
# is no public /media/ path to expose, by design, not an oversight.
# ------------------------------------------------
location /media/ {
    return 404;
}

# ------------------------------------------------
# HEALTH (public, rate-limited; also used by external monitors via nginx)
# ------------------------------------------------
location = /api/v1/health/ {
    limit_req zone=health_limit burst=5 nodelay;
    limit_req_status 429;

    proxy_pass http://backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
}

# ------------------------------------------------
# BACKEND API (DJANGO)
# n.b. client_max_body_size for /api/ (20 in prod.conf.template, the server
# default 1m in dev.conf.template's absence) must stay at least as big as the
# backend's MAX_ORG_UPLOAD_SIZE_CEILING_MB (config/settings.py) - a per-org
# limit above nginx's cap would silently truncate to nginx's instead, and the
# backup-upload route below carves out its own, much larger allowance.
# ------------------------------------------------
location /api/ {
    limit_req zone=api_limit burst=50 nodelay;
    limit_req_status 429;

    # API JSON compresses 3-5x and Django doesn't compress it itself. Only
    # here (Next.js already compresses its own pages); never for /api/v1/auth/
    # below - see the BREACH note there.
    gzip on;
    gzip_types application/json text/csv text/plain;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;

    proxy_pass http://backend;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_http_version 1.1;
}

# ------------------------------------------------
# AUTH API - identical to /api/ above except never compressed. Login,
# refresh and registration responses carry the access token; compressing a
# secret in the same HTTPS response as attacker-influenced input leaks it
# through response sizes (BREACH). Every endpoint that issues tokens lives
# under /api/v1/auth/ (the accounts app).
# ------------------------------------------------
location /api/v1/auth/ {
    limit_req zone=api_limit burst=50 nodelay;
    limit_req_status 429;

    gzip off;

    proxy_pass http://backend;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_http_version 1.1;
}

# ------------------------------------------------
# BACKUP UPLOAD (restore from a .zip) - the one route allowed a body far
# past the server-wide 20m cap; Django enforces its own exact limit
# (BACKUP_UPLOAD_MAX_SIZE_MB, see backend/config/settings.py), keep this at
# least that big. Same auth/permission gate as the rest of /api/.
# ------------------------------------------------
location = /api/v1/backups/restores/upload/ {
    limit_req zone=api_limit burst=5 nodelay;
    limit_req_status 429;

    client_max_body_size 5g;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    proxy_pass http://backend;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_http_version 1.1;
}

# ------------------------------------------------
# Django admin / OpenAPI schema+docs (DEBUG-only on the backend itself -
# see backend/config/urls.py; proxied here unconditionally, same as /api/)
# ------------------------------------------------
location ~ ^/(admin|api/schema|api/docs)/ {
    limit_req zone=api_limit burst=50 nodelay;
    proxy_pass http://backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# ------------------------------------------------
# NEXT.JS IMMUTABLE STATIC ASSETS
# ------------------------------------------------
location /_next/static/ {
    proxy_pass http://frontend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "public, max-age=31536000, immutable";
    access_log off;
}

# ------------------------------------------------
# FRONTEND (NEXT.JS)
# Catch-all - matched only when none of the more specific locations above
# (/static/, /media/, /api/v1/health/, /api/, admin/schema/docs) match,
# since nginx always prefers the most specific match regardless of
# declaration order.
# ------------------------------------------------
location / {
    limit_req zone=web_limit burst=50 nodelay;
    proxy_pass http://frontend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
}

# ------------------------------------------------
# RATE LIMIT RESPONSE (JSON)
# ------------------------------------------------
error_page 429 = @rate_limited;

location @rate_limited {
    default_type application/json;
    return 429 '{"detail": "Too many requests"}';
}

# ------------------------------------------------
# NGINX STATUS (LOCAL ONLY)
# ------------------------------------------------
location /stub_status {
    stub_status;

    # Allow localhost
    allow 127.0.0.1;
    # Allow the default docker compose bridge network range
    allow 172.16.0.0/12;
    deny all;
}
