# ====================================================
# SHARED LOCATION BLOCKS - included inside the server{} block of both
# dev.conf.template (plain HTTP) and prod.conf.template (HTTPS, behind
# Let's Encrypt) via `include /etc/nginx/conf.d/locations.inc;` - kept in
# one file so the two environments' proxy/security behavior can't drift
# apart from each other. This file's own .template suffix still gets
# stripped by envsubst like any other template, but note it renders to
# "locations.inc" (not "locations.conf") specifically so nginx's own
# `include conf.d/*.conf` wildcard (in its base image config) never loads
# it directly at the top level, where bare `location` blocks outside a
# server{} would be a syntax error - it's only ever reachable via the
# explicit `include` line in dev.conf.template/prod.conf.template.
#
# $scheme is trustworthy here in both environments: dev's server only ever
# listens on plain HTTP, and prod's HTTPS server (where this is actually
# included) is the TLS termination point itself, not a hop behind some
# other proxy - no X-Forwarded-Proto trust/spoofing question to worry about.
# ====================================================

# ------------------------------------------------
# SECURITY HEADERS
# Django's own SecurityMiddleware/XFrameOptionsMiddleware already send
# X-Content-Type-Options/X-Frame-Options/Referrer-Policy by default (see
# backend/config/settings.py) - add_header alone would APPEND to those,
# not replace them, leaving two (for Referrer-Policy, conflicting) values
# on the same response. proxy_hide_header strips the upstream's copy
# first so nginx's values below are the only ones that reach the client.
# ------------------------------------------------
proxy_hide_header X-Content-Type-Options;
proxy_hide_header X-Frame-Options;
proxy_hide_header Referrer-Policy;
add_header X-Content-Type-Options nosniff always;
add_header X-Frame-Options DENY always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# ------------------------------------------------
# CSP (Content Security Policy) - off by default
# NOTE: left commented because the example policy below hasn't been
# verified against a real production build (script-src 'unsafe-eval' in
# particular is a dev-mode/Turbopack-HMR need, not something to ship
# blindly) - test thoroughly before enabling, then tighten further.
# ------------------------------------------------
# add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http:;" always;

# ------------------------------------------------
# STATIC FILES (DJANGO)
# Proxied to the backend rather than served directly from a shared
# filesystem alias - WhiteNoise already serves /static/ as part of the
# normal Django request/response cycle in both DEBUG (via
# WHITENOISE_USE_FINDERS, straight from each app's static/ dir - see
# backend/config/settings.py) and non-DEBUG (from the collected
# STATIC_ROOT), so there is nothing extra nginx needs mounted to make
# this work correctly in either environment.
# ------------------------------------------------
location /static/ {
    limit_req zone=api_limit burst=50 nodelay;
    proxy_pass http://backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
}

# ------------------------------------------------
# MEDIA - no direct serving
# Every uploaded file in this app requires an authenticated, permission-
# checked Django request to download (see backend/files/views.py) - there
# is no public /media/ path to expose, by design, not an oversight.
# ------------------------------------------------
location /media/ {
    return 404;
}

# ------------------------------------------------
# HEALTH (public, rate-limited; also used by external monitors via nginx)
# ------------------------------------------------
location = /api/v1/health/ {
    limit_req zone=health_limit burst=5 nodelay;
    limit_req_status 429;

    proxy_pass http://backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
}

# ------------------------------------------------
# BACKEND API (DJANGO)
# ------------------------------------------------
location /api/ {
    limit_req zone=api_limit burst=50 nodelay;
    limit_req_status 429;

    proxy_pass http://backend;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_http_version 1.1;
}

# ------------------------------------------------
# Django admin / OpenAPI schema+docs (DEBUG-only on the backend itself -
# see backend/config/urls.py; proxied here unconditionally, same as /api/)
# ------------------------------------------------
location ~ ^/(admin|api/schema|api/docs)/ {
    limit_req zone=api_limit burst=50 nodelay;
    proxy_pass http://backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# ------------------------------------------------
# FRONTEND (NEXT.JS)
# Catch-all - matched only when none of the more specific locations above
# (/static/, /media/, /api/v1/health/, /api/, admin/schema/docs) match,
# since nginx always prefers the most specific match regardless of
# declaration order.
# ------------------------------------------------
location / {
    limit_req zone=web_limit burst=50 nodelay;
    proxy_pass http://frontend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
}

# ------------------------------------------------
# RATE LIMIT RESPONSE (JSON)
# ------------------------------------------------
error_page 429 = @rate_limited;

location @rate_limited {
    default_type application/json;
    return 429 '{"detail": "Too many requests"}';
}

# ------------------------------------------------
# NGINX STATUS (LOCAL ONLY)
# ------------------------------------------------
location /stub_status {
    stub_status;

    # Allow localhost
    allow 127.0.0.1;
    # Allow the default docker compose bridge network range
    allow 172.16.0.0/12;
    deny all;
}
