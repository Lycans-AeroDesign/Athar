# Copy this file to .env at the repo root before running docker-compose.
# These variables are consumed directly by docker-compose.yml /
# docker-compose.prod.yml. Backend and frontend app-level settings live in
# backend/.env.example and frontend/.env.example respectively.

# Postgres (db service)
POSTGRES_DB=lycans_kms
POSTGRES_USER=lycans
POSTGRES_PASSWORD=lycans
POSTGRES_PORT=5432

# Host port mappings
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80

# Django (also required by the backend container)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT auth (also required by the backend container - see backend/.env.example
# for what each of these controls)
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_DOMAIN=
ENABLE_REGISTRATION=True

# File storage - local disk by default (leave these unset/empty). Set
# AWS_STORAGE_BUCKET_NAME to switch to S3-compatible object storage instead
# (AWS S3, Cloudflare R2, Backblaze B2, self-hosted MinIO, ...) - see
# backend/.env.example for what each of these controls.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=virtual

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
