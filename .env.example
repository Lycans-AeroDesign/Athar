# Copy this file to .env at the repo root before running docker-compose.
# These variables are consumed directly by docker-compose.yml /
# docker-compose.prod.yml. Backend and frontend app-level settings live in
# backend/.env.example and frontend/.env.example respectively.

# Postgres (db service)
POSTGRES_DB=lycans_kms
POSTGRES_USER=lycans
POSTGRES_PASSWORD=lycans
POSTGRES_PORT=5432

# Which published backend/frontend image tag docker-compose.prod.yml pulls
# (see .github/workflows/docker-publish.yml) - a git tag like v1.2.3, or
# "latest". Not used by docker-compose.yml (dev), which always builds
# locally.
IMAGE_TAG=latest

# Host port mappings
# BACKEND_PORT/FRONTEND_PORT are only published in docker-compose.yml (dev) -
# in docker-compose.prod.yml, backend/frontend have no host port at all, only
# nginx does, so NGINX_PORT/NGINX_SSL_PORT are the only ones of these that
# matter there.
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443

# nginx's server_name (see nginx/templates/) - "localhost" for local dev. In
# production, set this to your real domain (e.g. athar.example.com);
# docker-compose.prod.yml refuses to start without it. This alone does NOT
# also update ALLOWED_HOSTS/CORS_ALLOWED_ORIGINS/NEXT_PUBLIC_API_URL below -
# those need your real domain set explicitly too, in their own format
# (scheme, comma-separated lists, etc).
DOMAIN=localhost

# Production only - the email Let's Encrypt sends certificate
# expiry/renewal-problem notices to (see scripts/init_letsencrypt.sh and
# DEPLOYMENT.md). Not used at all in dev, which has no HTTPS/certs.
LETSENCRYPT_EMAIL=

# Django (also required by the backend container)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Production: your real domain(s), e.g. athar.example.com,www.athar.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Production: your real origin, e.g. https://athar.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT auth (also required by the backend container - see backend/.env.example
# for what each of these controls)
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_DOMAIN=
ENABLE_REGISTRATION=True

# File storage - local disk by default (leave these unset/empty). Set
# AWS_STORAGE_BUCKET_NAME to switch to S3-compatible object storage instead
# (AWS S3, Cloudflare R2, Backblaze B2, self-hosted MinIO, ...) - see
# backend/.env.example for what each of these controls.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=virtual

# Frontend
# Dev only (docker-compose.yml) - production's NEXT_PUBLIC_API_URL is baked
# into the published image at build time instead; see IMAGE_TAG above and
# DEPLOYMENT.md.
NEXT_PUBLIC_API_URL=http://localhost:8000
